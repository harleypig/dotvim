#!/bin/bash

#-----------------------------------------------------------------------------
usage() {
  cat << EOF
Usage: ${0##*/}

For every submodule in .gitmodules with no branch set, check out its
remote's default branch, record that branch in .gitmodules and commit
.gitmodules alone. A submodule whose checkout fails is reported and left
without a branch, and the script then exits non-zero. Run from the top of
the repository.
EOF
}

case $1 in
  -h | --help)
    usage
    exit 0
    ;;
esac

readarray -t submodules < <(grep '^\[submodule' .gitmodules | cut -d '"' -f 2)

oldpwd="$PWD"
failed=

for s in "${submodules[@]}"; do
  read -r branch < <(git config -f .gitmodules --get "submodule.$s.branch")
  [[ -n $branch ]] && continue

  read -r path < <(git config -f .gitmodules --get "submodule.$s.path")

  cd "$path" || {
    echo "error changing to $path, ignoring $s"
    continue
  }

  read -r default < <(git remote show origin | grep HEAD | rev | cut -d ' ' -f 1 | rev)

  # git prints "(unknown)" when the remote's HEAD names no branch.
  [[ -z $default || $default == '(unknown)' ]] && {
    echo "fatal error: no default branch found for $s"
    exit 1
  }

  if ! git checkout "$default"; then
    echo "error checking out $default in $path, no branch recorded for $s"
    failed=1

    # shellcheck disable=SC2164
    cd "$oldpwd"
    continue
  fi

  # shellcheck disable=SC2164
  cd "$oldpwd"

  git config -f .gitmodules --add "submodule.$s.branch" "$default"

  # Naming the path commits .gitmodules alone, whatever else is staged.
  git commit -q -m "set $s branch to $default" -- .gitmodules
done

[[ -z $failed ]]
