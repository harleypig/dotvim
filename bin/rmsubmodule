#!/bin/bash

#-----------------------------------------------------------------------------
usage() {
  cat << EOF
Usage: ${0##*/} NAME

Remove the submodule NAME (as named in .gitmodules): git rm its path,
commit, then delete its directory under .git/modules and its section in
.git/config. Run from the top of the repository.
EOF
}

case $1 in
  -h | --help)
    usage
    exit 0
    ;;
esac

(($#)) || {
  echo 'Must pass submodule to be removed.' >&2
  exit 1
}

name="$1"

read -r path < <(git config -f .gitmodules --get "submodule.${name}.path")

[[ -z $path ]] && {
  echo "$1 is not a submodule" >&2
  exit 1
}

git rm -r "$path" || {
  echo "Problem removing $name" >&2
  exit 1
}

git commit -m "removed $name and updated readme"

rm -fr ".git/modules/${path##*/}"
git config --remove-section "submodule.$name"
