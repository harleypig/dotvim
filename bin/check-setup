#!/bin/bash

# :shfmt -w -s -i 2 -bn -ci -sr %

# Load release information. CHECK_SETUP_OS_RELEASE points it at another file,
# so the tests can stand in for an OS other than the one running them.
# shellcheck disable=SC1090,SC1091
source "${CHECK_SETUP_OS_RELEASE:-/etc/os-release}"

##############################################################################
#-----------------------------------------------------------------------------
warn() { printf '%s\n' "$@" >&2; }
die() {
  (($#)) && warn "$@"
  exit 1
}

# XXX: Figure out a way to use docker instead of installing all the linters
#      and lsps ...

#-----------------------------------------------------------------------------
executable() {
  [[ -x "$(command -v "$1")" ]] && return 0
  return 1
}

#-----------------------------------------------------------------------------
install_msg() {
  local tool="$1" pkg="$2" osinstall msg

  if [[ -z $pkg ]]; then
    warn "$tool not installed: no package name known for $NAME"
    return
  fi

  if [[ $pkg == http* ]]; then
    osinstall="unknown package name - for $NAME"
    pkg="see $pkg"

  else
    case $NAME in
      'Arch Linux') osinstall='trizen -S' ;;
      Ubuntu) osinstall='apt install' ;;
      *) osinstall="(no install command known for $NAME)" ;;
    esac
  fi

  printf -v msg '%s not installed: %s %s' "$tool" "$osinstall" "$pkg"
  warn "$msg"
}

#-----------------------------------------------------------------------------
# os_pkg ARCH UBUNTU - the package name for this OS; empty on any other.
os_pkg() {
  case $NAME in
    'Arch Linux') printf '%s' "$1" ;;
    Ubuntu) printf '%s' "$2" ;;
  esac
}

#-----------------------------------------------------------------------------
usage() {
  cat << EOF
Usage: ${0##*/}

Report the tools this Vim setup expects that are missing: node and npm
(and whether node is new enough for CoC), plus the ansible and docker
linters when ansible or docker is installed. Each report carries an install
hint for Arch Linux or Ubuntu. Installs nothing.
EOF
}

#-----------------------------------------------------------------------------
declare -A checks

#-----------------------------------------------------------------------------
check_node() {
  if ! executable 'node'; then
    install_msg 'node' "$(os_pkg 'nodejs' 'nodejs')"
    return
  fi

  # Check Node.js version (CoC requires 14.14+)
  local node_version required_version
  node_version=$(node --version | sed 's/v//')
  required_version="14.14.0"

  if ! printf '%s\n%s\n' "$required_version" "$node_version" | sort -V | head -n1 | grep -q "^$required_version$"; then
    warn "Node.js version $node_version found, but CoC requires $required_version or higher"
  fi

  if ! executable 'npm'; then
    install_msg 'npm' "$(os_pkg 'npm' 'npm')"
  fi
}

checks[node]='check_node'

##############################################################################
# Ansible

check_ansible() {
  executable 'ansible' || return 0

  executable 'ansible-lint' || install_msg 'ansible-lint' 'ansible-lint'

  if ! executable 'ansible-language-server'; then
    install_msg 'ansible-language-server' "$(os_pkg 'ansible-language-server' 'https://als.readthedocs.io')"
  fi

  warn "ansible also depends on yamllint"
}

checks[ansible]='check_ansible'

##############################################################################
# Docker

check_docker() {
  executable 'docker' || return 0

  if ! executable 'docker_lint'; then
    install_msg 'docker_lint' "$(os_pkg 'docker-lint' 'https://github.com/projectatomic/dockerfile_lint')"
  fi

  if ! executable 'hadolint'; then
    install_msg 'hadolint' "$(os_pkg 'hadolint' 'https://github.com/hadolint/hadolint')"
  fi
}

checks[docker]='check_docker'

##############################################################################
# Run checks

case $1 in
  -h | --help)
    usage
    exit 0
    ;;
esac

mapfile -t sorted < <(printf '%s\n' "${!checks[@]}" | sort)

for check in "${sorted[@]}"; do
  "${checks[$check]}"
done
