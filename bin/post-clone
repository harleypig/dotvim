#!/usr/bin/env bash

#-----------------------------------------------------------------------------
usage() {
  cat << EOF
Usage: ${0##*/}

Set up a fresh clone: initialise and update the git submodules to their
remote branches, install Node.js through nvm if npm is missing, install the
npm and pipx tools this setup uses, and install the system packages with
apt-get or dnf (through sudo). Ends by listing what to install by hand.
EOF
}

case $1 in
  -h | --help)
    usage
    exit 0
    ;;
esac

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

##############################################################################
# Setup and Sanity

# Each list holds the linters, fixers and language servers the settings run:
# the late ale.vim, the after/ftplugin files and coc-settings.json. A
# language server a CoC extension bundles is left to the extension.

npm_packages=(
  "dockerfile-language-server-nodejs" # coc-settings languageserver.dockerfile
  "markdownlint-cli"                  # ALE markdown linter markdownlint
  "prettier"                          # ALE markdown fixer
  "vim-language-server"               # ALE vim linter vimls
)

# yamllint comes before ansible-lint, which depends on it, so the yamllint
# on PATH is its own install. ansible-lint and yamllint do not come with
# ansible.
pipx_packages=(
  "ansible"      # coc-ansible
  "yamllint"     # ALE yaml linter
  "ansible-lint" # coc-ansible
  "proselint"    # ALE markdown linter, coc-diagnostic
  "vint"         # ALE vim linter
  "isort"        # ALE python fixer
  "yapf"         # ALE python fixer
  "flake8"       # coc-pyright python.linting.flake8Enabled
  "sqlparse"     # ALE sql fixer sqlformat
)

system_packages=(
  "gawk"       # ALE awk linter
  "jq"         # ALE json and jsonc fixer
  "shellcheck" # coc-diagnostic sh
  "shfmt"      # ALE sh fixer
)

# hadolint, sqlint, terraform (ALE terraform and hcl fixer), terraform-ls
# (coc-settings languageserver.terraform) and tflint are configured too, but
# neither apt nor dnf carries them; terraform and terraform-ls are only in
# HashiCorp's own repository, which this script does not add. The closing
# message says how to install them.

# Each step that warns about a failure adds a line here. A missing pipx is
# reported as a status, not a warning, and is deliberately not a failure;
# the closing message names what it skipped instead.
failures=()
pipx_missing=

##############################################################################
# Functions
#-----------------------------------------------------------------------------
# section TITLE [COLOR] - a heading, in green unless COLOR is given.
section() { echo -e "\n${BLUE}==>${NC} ${2:-$GREEN}$1${NC}" >&2; }
status() { echo -e "${YELLOW}-->${NC} $1" >&2; }
error() { echo -e "${RED}Error:${NC} $1" >&2; }
warn() { echo -e "${YELLOW}Warning:${NC} $1" >&2; }

command_exists() { command -v "$1" > /dev/null 2>&1; }

# The name is matched whole, so ansible-core does not count as ansible.
pipx_package_installed() {
  pipx list --short | grep -q "^$1 "
}

##############################################################################
# Initialize and update git submodules
section "Initializing git submodules"

if git submodule update --init --recursive --remote; then
  status "Git submodules initialized successfully"
else
  warn "Git submodules not initialized. Do this manually."
  failures+=("git submodules")
fi

##############################################################################
# Check for npm installation
section "Checking for npm installation"

if ! command_exists npm; then
  status "npm not found, installing Node.js via nvm as documented"

  # Install nvm as documented in coc-ale-setup.md
  status "Installing nvm"
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh \
    | PROFILE='/dev/null' bash

  # shellcheck disable=SC1091
  source "$XDG_CONFIG_HOME/shell-startup/nodejs"

  # Install and use LTS version of Node.js
  status "Installing Node.js LTS version"
  nvm install --lts
  nvm use --lts

  # Verify npm installation
  if ! command_exists npm; then
    warn "npm installation failed. Please install manually."
    failures+=("npm: Node.js install through nvm")
    warn "Continuing with the rest of the setup..."
  else
    status "npm installed successfully"
  fi

else
  status "npm already installed"
fi

#-----------------------------------------------------------------------------
# Install npm packages
section "Installing npm packages"

if command_exists npm; then
  for package in "${npm_packages[@]}"; do
    if npm list -g "$package" &> /dev/null; then
      status "$package is already installed"
    else
      status "Installing $package"
      if ! npm install -g "$package"; then
        warn "Failed to install $package. Some features may not work correctly."
        failures+=("npm package: $package")
      fi
    fi
  done

else
  warn "npm is not available. Skipping npm package installations."
  warn "The following packages will need to be installed manually:"
  for package in "${npm_packages[@]}"; do
    warn "  - $package"
  done
fi

##############################################################################
# Check for pipx installation
section "Checking for pipx installation"

if ! command_exists pipx; then
  pipx_missing=1
  status "pipx not found. Skipping pipx package installations."
  status "Please install pipx manually to use the following packages:"
  for package in "${pipx_packages[@]}"; do
    status "  - $package"
  done

else
  status "pipx found, installing packages"

  # Install pipx packages
  section "Installing pipx packages"

  for package in "${pipx_packages[@]}"; do
    if pipx_package_installed "$package"; then
      status "$package is already installed"
    else
      status "Installing $package"
      if ! pipx install "$package" --include-deps; then
        warn "Failed to install $package with pipx. Some features may not work correctly."
        failures+=("pipx package: $package")
      fi
    fi
  done
fi

##############################################################################
# Install other packages using system package manager
section "Installing other required packages"

# Detect OS
if command_exists apt-get; then
  # Check which packages are already installed
  installed_packages=()
  for package in "${system_packages[@]}"; do
    if dpkg -l "$package" &> /dev/null; then
      status "$package is already installed"
    else
      installed_packages+=("$package")
    fi
  done

  # Install missing packages
  if [ ${#installed_packages[@]} -gt 0 ]; then
    status "Installing missing packages: ${installed_packages[*]}"
    if ! sudo apt-get install -y "${installed_packages[@]}"; then
      warn "Failed to install some system packages"
      failures+=("system packages: ${installed_packages[*]}")
    fi
  else
    status "All system packages are already installed"
  fi

elif command_exists dnf; then
  # Check which packages are already installed
  installed_packages=()
  for package in "${system_packages[@]}"; do
    if rpm -q "$package" &> /dev/null; then
      status "$package is already installed"
    else
      installed_packages+=("$package")
    fi
  done

  # Install missing packages
  if [ ${#installed_packages[@]} -gt 0 ]; then
    status "Installing missing packages: ${installed_packages[*]}"
    if ! sudo dnf install -y "${installed_packages[@]}"; then
      warn "Failed to install some system packages"
      failures+=("system packages: ${installed_packages[*]}")
    fi
  else
    status "All system packages are already installed"
  fi

else
  warn "Could not detect package manager. Please install the following packages manually."
  failures+=("system packages: no apt-get or dnf found")
  for package in "${system_packages[@]}"; do
    warn " - $package"
  done
fi

##############################################################################
# Mention manual installations
section "Manual installations required"

status "The following tools need to be installed manually:"
status "- hadolint: Used for Dockerfile linting"
status '    gh release download --repo hadolint/hadolint --pattern "hadolint-linux-x86_64"'
status "    sudo install -m 755 hadolint-linux-x86_64 /usr/local/bin/hadolint"
status "- sqlint: Used for SQL linting; a Ruby gem"
status "    gem install sqlint"
status "- terraform: Used for Terraform formatting; from HashiCorp's repository"
status "    https://developer.hashicorp.com/terraform/install"
status "- terraform-ls: The Terraform language server; from the same repository"
status "    https://github.com/hashicorp/terraform-ls/blob/main/docs/installation.md"
status "- tflint: Used for Terraform linting (see hashicorp.md for instructions)"
status "  Using curl:"
status "    curl -s https://raw.githubusercontent.com/terraform-linters/tflint/master/install_linux.sh | bash"
status "  Using GitHub CLI:"
status '    gh release download --repo terraform-linters/tflint --pattern "*_linux_amd64.zip"'
status "    unzip tflint_*_linux_amd64.zip"
status "    sudo install -m 755 tflint /usr/local/bin/"

if ((${#failures[@]})); then
  section "Setup did not complete" "$RED"
  for failure in "${failures[@]}"; do
    error "$failure"
  done
  exit 1
fi

if [[ -n $pipx_missing ]]; then
  section "Setup completed, but pipx was not found" "$YELLOW"
  status "Skipped: ${pipx_packages[*]}"

else
  section "Setup completed successfully!"
  status "All required packages have been installed."
fi

status "You may need to restart your terminal to use newly installed tools."
status "Note: This script doesn't modify any shell configuration files."
status "If tools aren't available in your PATH, you may need to add their locations manually."
