#!/usr/bin/env bash

#-----------------------------------------------------------------------------
usage() {
  cat << EOF2
Usage: ${0##*/}

Rewrite the g:coc_global_extensions list in .vimrc from the CoC extensions
installed on this machine, sorted by name. Run from the top of the
repository. Installed extensions are read from package.json in
\$COC_EXTENSIONS_DIR, which defaults to coc/extensions in \$XDG_CONFIG_HOME
when that is a directory, as CoC itself does, and to ~/.config/coc/extensions
otherwise. Nothing is written when no extensions are installed, package.json
cannot be parsed, or .vimrc has no list to replace.
EOF2
}

case $1 in
  -h | --help)
    usage
    exit 0
    ;;
esac

#-----------------------------------------------------------------------------
die() {
  echo "$*" >&2
  exit 1
}

##############################################################################
config_home="$HOME/.config"
[[ -n $XDG_CONFIG_HOME && -d $XDG_CONFIG_HOME ]] && config_home=$XDG_CONFIG_HOME

package="${COC_EXTENSIONS_DIR:-$config_home/coc/extensions}/package.json"

[[ -r $package ]] || die "Cannot read $package."

names=$(jq -r '.dependencies // {} | keys[]' "$package") \
  || die "Cannot parse $package."

[[ -n $names ]] || die "No CoC extensions are installed in $package."

readarray -t extensions <<< "$names"

[[ -w .vimrc ]] \
  || die "No writable .vimrc here; run from the top of the repository."

list='let g:coc_global_extensions = ['$'\n'
printf -v entries "  \\\\ '%s',\n" "${extensions[@]}"
list+="$entries  \\]"$'\n'

# The list reaches perl through the environment, so the @ and $ in names
# such as @yaegassy/coc-ansible are never interpolated by perl or the shell.
# perl -i writes a temporary file and renames it only on success, so a die
# leaves .vimrc as it was.
COC_LIST="$list" perl -0777 -i -pe '
  s/^let g:coc_global_extensions = \[\n.*?^\s*\\\s*\]\n/$ENV{COC_LIST}/ms
    or die "No g:coc_global_extensions list found in .vimrc.\n";
' .vimrc
